{
  "name": "koishi-plugin-chatlog",
  "description": "Group chat log collector for Koishi: ingests every message (text/image/url) into the database, with jieba tokenization and offline backfill (catchup) via NapCat history API.",
  "version": "0.1.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "author": "yiyikneesocks",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin",
    "chatlog",
    "history",
    "catchup"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "koishi": "^4.18.11",
    "koishi-plugin-jieba": "^0.5.0"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-jieba": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyikneesocks/koishi-plugin-chatlog.git"
  },
  "homepage": "https://github.com/yiyikneesocks/koishi-plugin-chatlog#readme",
  "bugs": {
    "url": "https://github.com/yiyikneesocks/koishi-plugin-chatlog/issues"
  }
}
